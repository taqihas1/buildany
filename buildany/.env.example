# BuildAny Environment Variables
# ================================
# CRITICAL: NEVER commit this file with real values to GitHub!
# Copy to .env.local (which is gitignored) and fill in your values.

# AI Model API Keys
# -----------------
# Get from https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Optional: Hermes Agent (local LLM)
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=optional-hermes-key

# GitHub Integration
# ------------------
# Create at https://github.com/settings/tokens
# Required scopes: repo, workflow
GITHUB_TOKEN=ghp_your_github_token_here

# Cloudflare Integration
# ----------------------
# Create at https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:Read, DNS:Edit, Page Rules:Edit, Cache Purge:Edit
CLOUDFLARE_API_TOKEN=your-cloudflare-token-here

# Deployment Settings
# -------------------
PROJECTS_DIR=/root/buildany/projects
BUILDANY_URL=https://base66.cloud

# Database (if using external DB)
# DATABASE_URL=postgresql://user:pass@localhost:5432/buildany
